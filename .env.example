# Production .env for docker-compose.yml.
# Copy to .env and fill in the values. On EC2 the real file is written by CI
# from the ENV_FILE GitHub Actions secret on every deploy.
# Local dev doesn't need this file: docker-compose.dev.yml sets its own values.

# --- App ---
GO_ENV=production            # secure cookies on .flashatapp.com + WebSocket origin check
REGISTER_CODE=               # code users must enter to register

# --- Postgres (backend + db service) ---
DB_USER=
DB_PASS=
DB_NAME=
DB_HOST=db                   # compose service name
DB_PORT=5432

# --- Redis (backend) ---
REDIS_ADDR=redis:6379

# --- RabbitMQ (backend + rabbitmq service) ---
MQ_USER=
MQ_PASS=
MQ_ADDR=rabbitmq:5672        # host:port only, amqp://user:pass@ is added in code

# --- AWS ---
# No AWS keys needed: credentials come from the EC2 instance role.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Grafana (grafana service) ---
GRAFANA_USER=
GRAFANA_PASSWORD=
